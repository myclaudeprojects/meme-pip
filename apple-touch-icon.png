ease,transform .32s cubic-bezier(.22,1,.36,1)}.toast--hidden{opacity:0;transform:translate(12px);pointer-events:none}.toast__rail{width:3px;flex-shrink:0;background:var(--toast-rail)}.toast--success{--toast-rail:var(--color-green)}.toast--error{--toast-rail:#ff3b3b;border-color:#ff3b3b47;box-shadow:0 0 0 1px #ff3b3b1f,0 16px 48px #0000008c}.toast--info{--toast-rail:var(--color-content-40)}.toast__main{display:flex;align-items:flex-start;gap:12px;flex:1;min-width:0;padding:14px 6px 14px 14px}.toast__icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;flex-shrink:0;color:var(--color-content-45)}.toast--success .toast__icon{color:var(--color-green)}.toast--error .toast__icon{color:#ff3b3beb}.toast--info .toast__icon{color:var(--color-content-55)}.toast__message{flex:1;margin:0;padding-top:6px;padding-bottom:2px}.toast__close{flex-shrink:0;display:flex;align-items:flex-start;justify-content:center;align-self:stretch;background:0 0;border:none;padding:12px 12px 12px 4px;margin:0;cursor:pointer;color:var(--color-content-30);transition:color .2s ease}.toast__close:hover{color:var(--color-content-85)}.toast__close:focus-visible{outline:2px solid var(--color-flare);outline-offset:-4px}</style></head><body class="flex flex-col grow" data-locale=en-US><script type=application/ld+json>{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.quantus.com/"},{"@type":"ListItem","position":2,"name":"404 Not Found","item":"https://www.quantus.com/404/"}]}</script><nav class="flex items-center border-b justify-between [&.scrolled]:backdrop-blur-md [&.scrolled]:bg-navbar-scrolled [&.visible]:opacity-100 backdrop-blur-xs bg-navbar border-border duration-500 ease-in-out fixed left-0 lg:py-5 md:px-content-edges opacity-0 px-content-edges-mobile py-4 right-0 top-0 transition-all z-1000" id=navbar><a class="leading-none block" href=/ ><svg class="h-[26px] block w-auto" fill